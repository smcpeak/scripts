#!/usr/bin/env python3
# adjust indentation in a program

import sys
import re

def numeric(s: str) -> bool:
  return bool(re.match(r'^\d+$', s))

def main() -> None:
  if len(sys.argv) != 3:
    print(f"usage: {sys.argv[0]} current-indent-amount desired-indent-amount")
    sys.exit(2)

  current = sys.argv[1]
  desired = sys.argv[2]

  if not (numeric(current) and numeric(desired)):
    sys.exit("arguments must be numeric")

  current_amt = int(current)
  desired_amt = int(desired)

  line_num = 0
  for line in sys.stdin:
    line_num += 1
    line = line.rstrip("\n")
    match = re.match(r'^( *)(.*)$', line)
    if not match:
      continue

    spaces, rest = match.groups()
    ind = len(spaces)
    if ind % current_amt != 0:
      print(f"warning: line {line_num} has unexpected indent level {ind}",
            file=sys.stderr)

    ind = (ind // current_amt) * desired_amt
    print(" " * ind + rest)

if __name__ == "__main__":
  main()
